# CONTINUUM Environment Configuration

# PostgreSQL Connection
DATABASE_URL=postgresql+psycopg://shaaunak@localhost:5432/continuum
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=continuum
POSTGRES_USER=shaaunak
POSTGRES_PASSWORD=

# Backend API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Business Calendar & Operations Config
BUSINESS_TIMEZONE=America/New_York
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=17:00
INACTIVITY_THRESHOLD_DAYS=90
AS_OF_DATE=2026-10-31

# Synthetic Data Generator
DATA_SEED=20270101
DATASET_SCALE=full
# Options: full (~12,000 clients) | compact (~2,400 clients for low-resource machines)

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
